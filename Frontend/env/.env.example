# ── Frontend environment (copy to env/.env and fill in) ─────────────────────
# Public base URL of the backend API. Browser-visible, baked at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: Google AdSense publisher id (e.g. ca-pub-1234567890123456).
# Leave unset to run ad-free; ads only render once this is provided.
NEXT_PUBLIC_ADSENSE_CLIENT=
