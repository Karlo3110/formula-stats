# ── Frontend environment (copy to env/.env and fill in) ─────────────────────
# Public base URL of the backend API. Browser-visible, baked at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Canonical site origin (no trailing slash). Drives SEO metadata, canonical
# URLs, sitemap.xml, robots.txt, and Open Graph tags. Set per environment, e.g.
# https://staging.formula-stats.com (staging) or https://formula-stats.com (prod).
NEXT_PUBLIC_SITE_URL=https://staging.formula-stats.com

# Google AdSense publisher id. The AdSense script, ad slots, /ads.txt, and the
# verification meta tag activate ONLY where this is set — set it in the
# PRODUCTION environment so staging and local dev stay ad-free.
# Production value: ca-pub-9585717398775011
NEXT_PUBLIC_ADSENSE_CLIENT=
