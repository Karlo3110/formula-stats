// Prisma schema — Formula Stats backend.
// Conventions follow .claude/rules/database/database-standards.md:
// snake_case tables/columns, UUID v7 primary keys, timestamptz, soft delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account lifecycle. Transitions are enforced in the service layer, never by clients.
/// PENDING_VERIFICATION -> ACTIVE -> (SUSPENDED | LOCKED | DEACTIVATED)
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  role            String    @default("MEMBER")
  status          String    @default("PENDING_VERIFICATION")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── F1 data (fetched from FastF1 via the data service, persisted for history
// and to shield upstream rate limits) ───────────────────────────────────────

model F1Event {
  id          String    @id @default(uuid(7)) @db.Uuid
  season      Int
  roundNumber Int       @map("round_number")
  eventName   String    @map("event_name")
  country     String
  location    String
  eventDate   DateTime? @map("event_date") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([season, roundNumber])
  @@map("f1_events")
}

model F1SessionResult {
  id            String   @id @default(uuid(7)) @db.Uuid
  season        Int
  roundNumber   Int      @map("round_number")
  session       String
  position      Int?
  driverNumber  String   @map("driver_number")
  abbreviation  String
  fullName      String   @map("full_name")
  teamName      String   @map("team_name")
  points        Float
  status        String
  gridPosition  Int?     @map("grid_position")
  laps          Int?
  timeSeconds   Float?   @map("time_seconds")
  teamColor     String?  @map("team_color")
  headshotUrl   String?  @map("headshot_url")
  countryCode   String?  @map("country_code")
  /// Shape version of the stored row (see RESULTS_DETAIL_VERSION).
  detailVersion Int      @default(0) @map("detail_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([season, roundNumber, session, driverNumber])
  @@index([season, roundNumber, session])
  @@map("f1_session_results")
}

model F1TrackMap {
  id          String   @id @default(uuid(7)) @db.Uuid
  season      Int
  roundNumber Int      @map("round_number")
  session     String
  points      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([season, roundNumber, session])
  @@map("f1_track_maps")
}
