# ── Backend environment (copy to env/.env and fill in) ──────────────────────
NODE_ENV=development
PORT=3001

# PostgreSQL connection string (Railway provides this)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formula_stats

# Redis connection string (Railway provides this)
REDIS_URL=redis://localhost:6379

# JWT secrets — each MUST be at least 32 chars and differ per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Public URL of the frontend (used to build email links)
APP_WEB_URL=http://localhost:3000

# Resend transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Formula Stats <no-reply@your-domain.com>"

# Ephemeral token lifetimes (minutes)
EMAIL_VERIFICATION_TTL_MIN=15
PASSWORD_RESET_TTL_MIN=30

# FastF1 data service (private Railway URL + shared internal key)
DATA_SERVICE_URL=http://localhost:8000
DATA_SERVICE_INTERNAL_KEY=
DATA_SERVICE_TIMEOUT_MS=30000

# Optional: cookie domain for the refresh-token cookie in production
# COOKIE_DOMAIN=.your-domain.com
