# ── Data service environment (copy to env/.env and fill in) ─────────────────
PORT=8000
FASTF1_CACHE_DIR=.fastf1-cache

# Comma-separated origins allowed by CORS (the NestJS backend)
CORS_ORIGINS=http://localhost:3001

# Shared secret the backend must send as the X-Internal-Key header.
# Leave empty to disable the check in local development.
INTERNAL_API_KEY=

# F1 TV account (F1 TV Access or higher) FastF1 signs in with. Since October 2026
# livetiming.formula1.com requires it for timing, positions and driver headshots.
# Secrets: set them in the platform's variables, never commit real values.
F1_USERNAME=
F1_PASSWORD=
